{
    "$schema": "https://mintlify.com/docs.json",
    "name": "AgentHeaven",
    "description": "Ask not what your agents can do for you, ask what you can do for your agents.",
    "theme": "palm",
    "colors": {
        "primary": "#C70008",
        "light": "#D33941",
        "dark": "#7F0001"
    },
    "favicon": "/images/favicon.ico",
    "logo": {
        "light": "/images/logo-light.png",
        "dark": "/images/logo-dark.png",
        "href": "https://rubiksql.github.io/AgentHeaven-docs/"
    },
    "appearance": {
        "default": "dark",
        "strict": true
    },
    "fonts": {
        "heading": {
            "family": "HarmonyOS Sans",
            "source": "/fonts/HarmonyOS_Sans_Black.woff2",
            "format": "woff2",
            "weight": 900
        },
        "body": {
            "family": "HarmonyOS Sans",
            "source": "/fonts/HarmonyOS_Sans_Regular.woff2",
            "format": "woff2",
            "weight": 500
        }
    },
    "background": {
        "decoration": "gradient"
    },
    "styling": {
        "codeblocks": {
            "theme": {
                "light": "github-light",
                "dark": "github-dark"
            }
        }
    },
    "search": {
        "prompt": "Search AgentHeaven docs..."
    },
    "seo": {
        "indexing": "navigable"
    },
    "navbar": {
        "primary": {
            "type": "github",
            "href": "https://github.com/RubikSQL/AgentHeaven"
        },
        "links": []
    },
    "footer": {
        "socials": {
            "github": "https://github.com/RubikSQL/AgentHeaven"
        }
    },
