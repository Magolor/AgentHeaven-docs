{
    "$schema": "https://mintlify.com/docs.json",
    "name": "AgentHeaven",
    "description": "Ask not what your agents can do for you, ask what you can do for your agents.",
    "theme": "palm",
    "colors": {
        "primary": "#C70008",
        "light": "#D33941",
        "dark": "#7F0001"
    },
    "favicon": "/images/favicon.ico",
    "logo": {
        "light": "/images/logo-light.png",
        "dark": "/images/logo-dark.png",
        "href": "https://ahvn.top"
    },
    "appearance": {
        "default": "dark",
        "strict": true
    },
    "fonts": {
        "heading": {
            "family": "HarmonyOS Sans",
            "source": "/fonts/HarmonyOS_Sans_Black.woff2",
            "format": "woff2",
            "weight": 900
        },
        "body": {
            "family": "HarmonyOS Sans",
            "source": "/fonts/HarmonyOS_Sans_Regular.woff2",
            "format": "woff2",
            "weight": 500
        }
    },
    "background": {
        "decoration": "gradient"
    },
    "styling": {
        "codeblocks": {
            "theme": {
                "light": "github-light",
                "dark": "github-dark"
            }
        }
    },
    "search": {
        "prompt": "Search AgentHeaven docs..."
    },
    "seo": {
        "indexing": "navigable",
        "metatags": {
            "canonical": "https://ahvn.top"
        }
    },
    "navbar": {
        "primary": {
            "type": "github",
            "href": "https://github.com/RubikSQL/AgentHeaven"
        },
        "links": []
    },
    "footer": {
        "socials": {
            "github": "https://github.com/RubikSQL/AgentHeaven"
        }
    },
    "navigation": {
        "languages": [
            {
                "language": "en",
                "tabs": [
                    {
                        "tab": "Documentation",
                        "groups": [
                            {
                                "group": "Introduction",
                                "pages": [
                                    "introduction/overview",
                                    "introduction/philosophy",
                                    "introduction/architecture"
                                ]
                            },
                            {
                                "group": "Quickstart",
                                "pages": [
                                    "quickstart/installation",
                                    "quickstart/quick-setup",
                                    "quickstart/first-llm-chat",
                                    "quickstart/first-mcp-toolkit"
                                ]
                            },
                            {
                                "group": "Features",
                                "pages": [
                                    "features/configuration",
                                    "features/prompts",
                                    "features/capsules",
                                    "features/tools",
                                    "features/toolkits"
                                ]
                            },
                            {
                                "group": "Blog",
                                "icon": "newspaper",
                                "pages": [
                                    "blog/index"
                                ]
                            },
                            {
                                "group": "Community",
                                "pages": [
                                    "community/roadmap",
                                    "community/contributing",
                                    "community/connect",
                                    "community/license",
                                    "community/citation"
                                ]
                            }
                        ]
                    },
                    {
                        "tab": "Blog",
                        "groups": [
                            {
                                "group": "Blog",
                                "pages": [
                                    "blog/index"
                                ]
                            }
                        ]
                    }
                ]
            },
            {
                "language": "cn",
                "tabs": [
                    {
                        "tab": "文档",
                        "groups": [
                            {
                                "group": "介绍",
                                "pages": [
                                    "zh/introduction/overview",
                                    "zh/introduction/philosophy",
                                    "zh/introduction/architecture"
                                ]
                            },
                            {
                                "group": "快速开始",
                                "pages": [
                                    "zh/quickstart/installation",
                                    "zh/quickstart/quick-setup",
                                    "zh/quickstart/first-llm-chat",
                                    "zh/quickstart/first-mcp-toolkit"
                                ]
                            },
                            {
                                "group": "功能",
                                "pages": [
                                    "zh/features/configuration",
                                    "zh/features/prompts",
                                    "zh/features/capsules",
                                    "zh/features/tools",
                                    "zh/features/toolkits"
                                ]
                            },
                            {
                                "group": "博客",
                                "icon": "newspaper",
                                "pages": [
                                    "zh/blog/index"
                                ]
                            },
                            {
                                "group": "社区",
                                "pages": [
                                    "zh/community/roadmap",
                                    "zh/community/contributing",
                                    "zh/community/connect",
                                    "zh/community/license",
                                    "zh/community/citation"
                                ]
                            }
                        ]
                    },
                    {
                        "tab": "博客",
                        "groups": [
                            {
                                "group": "博客",
                                "pages": [
                                    "zh/blog/index"
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    },
    "banner": {
        "dismissible": true,
        "content": "🚧 AgentHeaven is in active experimental development. Features may change. NOT ready for stable deployment."
    }
}